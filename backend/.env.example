# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=nandini_club

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Admin login (synced into the admins table automatically on server start)
ADMIN_EMAIL=admin@nandinilayoutclub.in
ADMIN_PASSWORD=change_this_password

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM=noreply@nandinilayoutclub.in
MAIL_TO=admin@nandinilayoutclub.in

# Frontend URL(s) for CORS (comma-separated). Include BOTH apex and www.
FRONTEND_URL=http://localhost:5173,https://nandinilayoutclub.in,https://www.nandinilayoutclub.in
# Optional: override with a comma-separated list if you prefer
# ALLOWED_ORIGINS=http://localhost:5173,https://nandinilayoutclub.in,https://www.nandinilayoutclub.in

# Upload path
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
